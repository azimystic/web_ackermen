# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable QA artifacts (screenshots, hook cache) — not source
.impeccable/review/
.impeccable/hook.cache.json

# AI-assistant tooling: installed skill packages and local harness config,
# not project source. Reproducible via `npx impeccable install` /
# `npx skills add` rather than version-controlled.
.agents/
.claude/
.opencode/
skills-lock.json
